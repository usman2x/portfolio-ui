# Canonical public URL used for metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave empty when the site is served from the domain root
NEXT_PUBLIC_PATH_PREFIX=

# Server-side CMS origin used while rendering and building the static site
PAYLOAD_API_URL=http://localhost:3001

# Browser-visible CMS origin used by client-side requests such as contact submissions
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Payload collection endpoint used for writings and case studies
PAYLOAD_POSTS_ENDPOINT=/api/posts

# Optional Google Analytics measurement ID; leave empty locally
NEXT_PUBLIC_GA_TRACKING_ID=
